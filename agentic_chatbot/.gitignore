```gitignore
# ============================================================
# Project-specific: Agentic RAG Chatbot
# ============================================================

# Environment variables and secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Python virtual environments
.venv/
venv/
agentic/

# Python and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Uploaded documents (may contain confidential information)
uploaded_pdfs/

# FAISS vector database and local indexes
faiss_index/
faiss_indexes/
vectorstore/
vector_store/
index.faiss
index.pkl

# SQLite databases and checkpoint files
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sqlite-wal
*.sqlite-shm

# Logs
*.log

# Local model files
models/
checkpoints/

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
```
